{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/openagent-16.png",
    "32": "icons/openagent-32.png",
    "48": "icons/openagent-48.png",
    "128": "icons/openagent-128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabs",
    "webNavigation"
  ],
  "optional_permissions": [
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "__MSG_actionOpenSidePanel__",
    "default_icon": {
      "16": "icons/openagent-16.png",
      "24": "icons/openagent-24.png",
      "32": "icons/openagent-32.png",
      "48": "icons/openagent-48.png",
      "128": "icons/openagent-128.png"
    },
    "theme_icons": [
      { "dark": "icons/openagent-dark-16.png", "light": "icons/openagent-light-16.png", "size": 16 },
      { "dark": "icons/openagent-dark-32.png", "light": "icons/openagent-light-32.png", "size": 32 },
      { "dark": "icons/openagent-dark-48.png", "light": "icons/openagent-light-48.png", "size": 48 },
      { "dark": "icons/openagent-dark-128.png", "light": "icons/openagent-light-128.png", "size": 128 }
    ]
  },
  "host_permissions": [
    "http://localhost:8787/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/openagent-32.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-side-panel": {
      "description": "__MSG_commandOpenSidePanel__"
    }
  }
}
